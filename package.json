{
  "name": "omp-asr-zh",
  "version": "0.1.1",
  "type": "module",
  "description": "OMP extension: local Chinese streaming ASR (sherpa-onnx X-ASR) with live dictation",
  "author": "Yangtse Su",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "omp",
    "extension",
    "asr",
    "chinese",
    "speech-to-text",
    "sherpa-onnx",
    "x-asr"
  ],
  "os": [
    "linux"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YangtseSu/omp-asr-zh.git"
  },
  "homepage": "https://github.com/YangtseSu/omp-asr-zh#readme",
  "bugs": {
    "url": "https://github.com/YangtseSu/omp-asr-zh/issues"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "18.18.1",
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "sherpa-onnx-node": "1.13.2"
  }
}
